# Copy to .env.local. Never commit filled credentials.
# Create an Elasticsearch project at https://cloud.elastic.co/serverless-registration
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Dash0 OTLP HTTP base endpoint, without /v1/traces or a trailing slash.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=detour

# Set to your exact public HTTPS origin after deployment; leave blank locally.
APP_URL=

# JSON object mapping each supported event ID to a strong organizer-shared code.
# Required in production. Unset only for an explicitly open local development preview.
# Store real values in .env.local and the runtime Secret, never in this example.
EVENT_ACCESS_CODES=
