# Copy to .env.local. Never commit filled credentials.
# Create an Elasticsearch project at https://cloud.elastic.co/serverless-registration
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Dash0 OTLP HTTP base endpoint, without /v1/traces or a trailing slash.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=detour

# Set to your exact public HTTPS origin after deployment; leave blank locally.
APP_URL=
